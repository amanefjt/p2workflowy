{
  "permissions": {
    "allow": [
      "Bash(agent-browser snapshot *)",
      "Bash(agent-browser screenshot *)",
      "Bash(agent-browser scroll *)",
      "Bash(agent-browser open *)",
      "Bash(agent-browser skills *)",
      "Bash(agent-browser wait *)",
      "Bash(agent-browser get *)",
      "Bash(agent-browser close *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/check_management_logs.sh\"",
            "if": "Bash(git commit*)",
            "statusMessage": "変更管理ログの更新有無を確認中..."
          }
        ]
      }
    ]
  }
}
