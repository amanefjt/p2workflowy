GEMINI_API_KEY=your_paid_gemini_api_key_here

# CLI (main.py) 用: 無料枠プロジェクトのキー（最大4本。それぞれ別GCPプロジェクト必須。
# 無料枠の RPM/RPD/TPM はキー単位ではなく GCP プロジェクト単位のため、同一プロジェクトで
# 複数キーを発行しても枠は増えない）。429/503時に free1→…→free4→GEMINI_API_KEY(有料) の
# 順で自動フォールバックする（core/llm_client.py::KeyRotator）。加えて FREE tier では
# Phase1 VLM OCR・Phase4 翻訳のリクエストを「キー × Liteモデル」の2軸でラウンドロビン
# 分散し、レーン数ぶん RPM 上限を広げる（docs/model_optimization.md §8）。
# 未設定でも動く（本数に応じて自動的にレーン数が縮む）。
GEMINI_API_KEY_FREE_1=
GEMINI_API_KEY_FREE_2=
GEMINI_API_KEY_FREE_3=
GEMINI_API_KEY_FREE_4=

# Webアプリ (server.py) 用: 同時実行の並行スロットとして使う無料枠キー（最大5本、
# それぞれ別GCPプロジェクト必須。CLI用の2本とも別プロジェクトにすること）。
# 未設定時はプール機能自体が無効化され、従来通り GEMINI_API_KEY(有料)にフォールバック
# する（無制限・拒否なし）。設定すると、6人目以降の同時アクセスは「混雑中」として
# 拒否されるようになる（管理者パスコード・ユーザー自身のAPIキー入力時はこの枠を消費しない）。
GEMINI_API_KEY_WEB_1=
GEMINI_API_KEY_WEB_2=
GEMINI_API_KEY_WEB_3=
GEMINI_API_KEY_WEB_4=
GEMINI_API_KEY_WEB_5=

APP_ADMIN_PASSCODE=your_admin_passcode_here
PORT=8000
